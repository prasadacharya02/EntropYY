# ENTROPY lab configuration (copy to .env and adjust)

# Ganache / local Ethereum ledger
ENTROPY_GANACHE_URL=http://127.0.0.1:7545
ENTROPY_CONTRACT_ADDRESS=
ENTROPY_WALLET_ADDRESS=
# Fall back to the local SQLite ledger when Ganache is unreachable
ENTROPY_BLOCKCHAIN_FALLBACK=true

# Simulate destructive responses (quarantine/terminate) instead of running them.
# python lab.py always runs LIVE unless started with --dry-run.
ENTROPY_DRY_RUN=false

# Directories watched by the monitor (comma-separated, relative to the
# repository root). The victim demo estate is always included; data/testing
# is also included when no explicit value is set.
ENTROPY_WATCH_FOLDERS=

# ── Federated threat-fingerprint exchange ─────────────────────
# Master switch for the shared "have we seen this fingerprint before?"
# registry. Confirmed threats are written; a fingerprint seen by >=
# ENTROPY_EXCHANGE_CONFIRM_THRESHOLD independent nodes auto-confirms.
ENTROPY_EXCHANGE=true
# This node's identity in the exchange (defaults to a stable hostname
# id). Set a distinct value per tenant/node.
ENTROPY_NODE_ID=
# Independent-node consensus required to treat a fingerprint as a known
# threat (minimum 2 — a single node can only corroborate, never confirm).
ENTROPY_EXCHANGE_CONFIRM_THRESHOLD=2

# Maximum size for computing an exact streaming SHA-256 content fingerprint.
# Above the limit, entropy uses a sample hash and does not publish exact-file intel.
ENTROPY_CONTENT_HASH_MAX_BYTES=268435456

# Optional. Leave empty and the attacker console generates a fresh
# per-session operator token, embedded into the page it serves. Set a
# value to pin the token (scripted demos / CI).
ENTROPY_CONTROL_TOKEN=
